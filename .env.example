# Backend
DATABASE_URL=sqlite:///./rakshak.db
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_LINES=50000

# Optional ML / enrichment
ANOMALY_MODEL_PATH=data/models/isolation_forest.joblib
ABUSEIPDB_API_KEY=

# Optional AI - OpenAI-compatible chat/completions endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
 
# Demo Mode (set to true to enable the canned bad AI test toggle during presentations)
DEMO_MODE=true
